---
export interface Props {
  active?: 'dashboard' | 'new' | 'edit' | 'records';
}

const { active = 'dashboard' } = Astro.props;

const linkBase = 'text-sm font-medium transition-colors hover:text-gold';
const activeCls = 'text-gold';
const idleCls = 'text-cream/80';
---

<nav class="bg-forest text-cream">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a href="/admin" class="flex flex-col leading-tight">
      <span class="font-heading text-lg font-semibold">Pehiāweri B1B</span>
      <span class="text-[0.65rem] uppercase tracking-[0.25em] text-gold">Trustee Admin</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <span id="portal-user" class="text-xs text-cream/80" aria-live="polite"></span>
      <a href="/admin" class={`${linkBase} ${active === 'dashboard' ? activeCls : idleCls}`}>
        Dashboard
      </a>
      <a href="/admin/hui/new" class={`${linkBase} ${active === 'new' ? activeCls : idleCls}`}>
        New Hui
      </a>
      <a href="/admin/meeting-records" class={`${linkBase} ${active === 'records' ? activeCls : idleCls}`} aria-current={active === 'records' ? 'page' : undefined}>
        Meeting Records
      </a>
      <a href="/" class={`${linkBase} ${idleCls}`} target="_blank" rel="noopener">
        View site ↗
      </a>
      <button
        id="admin-logout"
        type="button"
        class="rounded-lg border border-gold/50 px-3 py-1.5 text-sm font-medium text-gold transition-colors hover:bg-gold hover:text-forest"
      >
        Sign out
      </button>
    </div>
  </div>
</nav>
<p id="logout-error" class="hidden px-6 py-3 text-sm text-red-800" role="alert"></p>

<script>
  import { getPortalClient } from '../lib/portal-client';

  const btn = document.getElementById('admin-logout') as HTMLButtonElement;
  const alert = document.getElementById('logout-error')!;
  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    try {
      const { error } = await getPortalClient().auth.signOut();
      if (error) throw error;
      window.location.replace('/admin/login');
    } catch (error) {
      alert.textContent = error instanceof Error ? error.message : 'Sign-out failed. Please try again.';
      alert.classList.remove('hidden');
      btn.disabled = false;
    }
  });
</script>
