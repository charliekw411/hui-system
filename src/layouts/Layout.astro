---
export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Pehiāweri B1B Ahu Whenua Trust', description = 'Hui notices and documents for the Pehiāweri B1B Ahu Whenua Trust.' } = Astro.props;

// Resolve public env for the browser. On Cloudflare the runtime env is on
// Astro.locals.runtime.env; locally it comes from import.meta.env.
const runtime = (Astro.locals as any)?.runtime?.env ?? {};
const meta = import.meta.env as Record<string, string | undefined>;

const PUBLIC_ENV = {
  SUPABASE_URL: runtime.SUPABASE_URL ?? meta.SUPABASE_URL ?? meta.PUBLIC_SUPABASE_URL ?? '',
  SUPABASE_ANON_KEY: runtime.SUPABASE_ANON_KEY ?? meta.SUPABASE_ANON_KEY ?? meta.PUBLIC_SUPABASE_ANON_KEY ?? '',
  API_BASE: runtime.PUBLIC_API_BASE ?? meta.PUBLIC_API_BASE ?? '/api',
};
---

<!doctype html>
<html lang="mi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline define:vars={{ PUBLIC_ENV }}>
      window.__PUBLIC_ENV__ = PUBLIC_ENV;
    </script>
  </head>
  <body class="min-h-screen bg-cream font-body text-forest antialiased flex flex-col">
    <header class="bg-forest text-cream">
      <div class="relative mx-auto max-w-4xl px-6 py-8 text-center">
        <a
          href="/admin"
          class="absolute right-6 top-6 rounded-md border border-gold/70 px-3 py-2 text-sm font-medium text-cream transition-colors hover:bg-gold hover:text-forest focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2 focus:ring-offset-forest"
        >
          Trustee login
        </a>
        <a href="/" class="inline-block">
          <h1 class="font-heading text-3xl sm:text-4xl font-semibold tracking-wide">
            Pehiāweri B1B
          </h1>
          <p class="mt-1 text-sm uppercase tracking-[0.3em] text-gold">Ahu Whenua Trust</p>
        </a>
        <p class="mt-4 font-heading italic text-gold/90 text-lg">oranga whenua · oranga reo</p>
      </div>
    </header>

    <main class="flex-1 w-full">
      <div class="mx-auto max-w-4xl px-6 py-10">
        <slot />
      </div>
    </main>

    <footer class="bg-forest-dark text-cream/70">
      <div class="mx-auto max-w-4xl px-6 py-6 text-center text-sm">
        <p>&copy; {new Date().getFullYear()} Pehiāweri B1B Ahu Whenua Trust</p>
        <p class="mt-1 font-heading italic text-gold/80">oranga whenua · oranga reo</p>
      </div>
    </footer>
  </body>
</html>
