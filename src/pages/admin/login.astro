---
import { getPublicEnv } from '../../lib/supabase';

export const prerender = false;
const PUBLIC_ENV = getPublicEnv(Astro.locals.runtime?.env);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Trustee login · Pehiāweri B1B</title>
    <script is:inline define:vars={{ PUBLIC_ENV }}>
      window.__PUBLIC_ENV__ = PUBLIC_ENV;
    </script>
  </head>
  <body class="min-h-screen bg-forest font-body text-forest antialiased flex items-center justify-center px-6">
    <div class="w-full max-w-md">
      <div class="text-center text-cream">
        <h1 class="font-heading text-3xl font-semibold">Pehiāweri B1B</h1>
        <p class="mt-1 text-xs uppercase tracking-[0.3em] text-gold">Ahu Whenua Trust</p>
        <p class="mt-3 font-heading italic text-gold/90">oranga whenua · oranga reo</p>
      </div>

      <div class="mt-8 rounded-2xl bg-cream p-8 shadow-xl">
        <h2 class="font-heading text-xl font-semibold text-forest">Trustee login</h2>
        <p class="mt-1 text-sm text-forest/70">Sign in to manage hui.</p>

        <div id="login-alert" class="mt-4 hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"></div>

        {PUBLIC_ENV.GOOGLE_SIGN_IN_ENABLED && (
          <div class="mt-6">
            <button id="google-login" type="button" class="w-full rounded-lg border border-forest/30 bg-white px-6 py-3 font-semibold text-forest hover:bg-cream-dark disabled:opacity-60">
              Continue with Google
            </button>
            <p class="mt-2 text-xs text-forest/70">Use the Google account matching your registered trustee email.</p>
          </div>
        )}

        <form id="login-form" class="mt-6 space-y-4">
          <p class="text-sm font-semibold">Trust administrator / emergency login</p>
          <div>
            <label class="block text-sm font-semibold" for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
              class="mt-1 w-full rounded-lg border border-cream-dark bg-white px-3 py-2 shadow-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold" for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="mt-1 w-full rounded-lg border border-cream-dark bg-white px-3 py-2 shadow-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold"
            />
          </div>
          <button
            id="login-btn"
            type="submit"
            class="w-full rounded-lg bg-forest px-6 py-3 font-semibold text-cream transition-colors hover:bg-forest-light disabled:opacity-60"
          >
            Sign in
          </button>
        </form>

        <p class="mt-6 text-center text-sm">
          <a href="/" class="text-forest/70 underline hover:text-gold-dark">← Back to public site</a>
        </p>
      </div>
    </div>

    <script>
      import { getPortalClient, requirePortalSession } from '../../lib/portal-client';

      const form = document.getElementById('login-form') as HTMLFormElement;
      const alertBox = document.getElementById('login-alert') as HTMLDivElement;
      const btn = document.getElementById('login-btn') as HTMLButtonElement;
      const googleBtn = document.getElementById('google-login') as HTMLButtonElement | null;

      function showError(msg: string) {
        alertBox.textContent = msg;
        alertBox.classList.remove('hidden');
      }

      function setBusy(busy: boolean) {
        btn.disabled = busy;
        if (googleBtn) googleBtn.disabled = busy;
      }

      async function init() {
        const supabase = getPortalClient();
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          alertBox.classList.add('hidden');
          setBusy(true);
          btn.textContent = 'Signing in…';
          try {
            const fields = new FormData(form);
            const { error } = await supabase.auth.signInWithPassword({
              email: String(fields.get('email') || '').trim(),
              password: String(fields.get('password') || ''),
            });
            if (error) throw error;
            await requirePortalSession();
            window.location.replace('/admin');
          } catch (error) {
            showError(error instanceof Error ? error.message : 'Sign-in failed.');
          } finally {
            setBusy(false);
            btn.textContent = 'Sign in';
          }
        });

        googleBtn?.addEventListener('click', async () => {
          setBusy(true);
          alertBox.classList.add('hidden');
          try {
            const { error } = await supabase.auth.signInWithOAuth({
              provider: 'google',
              options: {
                redirectTo: new URL('/auth/callback', window.location.origin).href,
                queryParams: { prompt: 'select_account' },
              },
            });
            if (error) throw error;
          } catch (error) {
            showError(error instanceof Error ? error.message : 'Google sign-in could not start.');
            setBusy(false);
          }
        });

        const { data, error } = await supabase.auth.getSession();
        if (error) throw error;
        if (data.session) {
          await requirePortalSession();
          window.location.replace('/admin');
        }
      }

      init().catch((error: unknown) => {
        showError(error instanceof Error ? error.message : 'Unable to initialise sign-in.');
      });
    </script>
  </body>
</html>
