---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import HuiForm from '../../../components/HuiForm.astro';

export const prerender = false;

const { id } = Astro.params;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const validId = id && UUID_RE.test(id);
if (!validId) Astro.response.status = 404;
---

<AdminLayout title="Edit Hui" active="edit">
  {!validId ? (
    <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
      Invalid hui id. <a href="/admin" class="underline">Back to dashboard</a>
    </div>
  ) : (
    <div>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="font-heading text-2xl font-semibold text-forest">Edit Hui</h1>
          <p class="mt-1 text-forest/70">Update the details for this hui.</p>
        </div>
      </div>
      <HuiForm mode="edit" huiId={id} />
    </div>
  )}

</AdminLayout>
