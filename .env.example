# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
SUPABASE_ANON_KEY=

# Supabase service role key — SECRET. Used only by the Cloudflare Worker.
# Never expose this to the browser or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive OAuth client used only by the Cloudflare Worker.
# Create a separate Desktop OAuth client with the Drive API enabled.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Local Worker URL. Preserve the configured production PUBLIC_API_BASE.
PUBLIC_API_BASE=http://localhost:8787/api

# Turn on only after database authorization and Google OAuth are configured.
PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
