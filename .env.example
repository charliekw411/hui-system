# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
SUPABASE_ANON_KEY=

# Supabase service role key — SECRET. Used only by the Cloudflare Worker.
# Never expose this to the browser or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=
